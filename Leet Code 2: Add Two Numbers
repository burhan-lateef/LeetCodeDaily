class Solution(object):
    def addTwoNumbers(self, l1, l2):

        head = ListNode(0)
        current = head
        carry = 0
        
        while l1 or l2 or carry:

            if l1:
                val1 = l1.val
            else:
                val1 = 0

            if l2:
                val2 = l2.val
            else:
                val2 = 0

            total = val1 + val2 + carry
            carry = total // 10
            digit = total % 10

            current.next = ListNode(digit)
            current = current.next

            if l1:
                l1 = l1.next
            else:
                val1 = 0

            if l2:
                l2 = l2.next
            else:
                val2 = 0

        return head.next
