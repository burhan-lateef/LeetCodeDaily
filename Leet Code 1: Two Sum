Using Python
1: Two Sum

Brute Force Solution: O(n^2) : Not Compatible Leet Code Solution
class Solution(object):
    def twoSum(self, nums, target):
        for i in range(len(nums)):          
            for j in range(i + 1, len(nums)): 
                if nums[i] + nums[j] == target:  
                    return [i, j]
        return [] 


Dictionary Concept: O(n) : Compatible with Leet Code
class Solution(object):
    def twoSum(self, nums, target):
        seen = {} 
        for i, num1 in enumerate(nums):
            num2 = target - num1
            if num2 in seen:
                return [seen[num2], i]
            seen[num1] = i
        return []

